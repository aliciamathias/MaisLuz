# Configurações do Ambiente MaisLuz
# Copie este arquivo para .env e preencha com suas configurações locais.
# O arquivo .env é ignorado pelo Git e nunca deve ser versionado.

# Chave secreta da aplicação Django
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=sua-chave-secreta-aqui

# Configurações do Banco de Dados PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=maisluz
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui
DB_HOST=localhost
DB_PORT=5432
