# Copie para .env e preencha. O .env não vai para o Git.
#
# O Django não lê este arquivo sozinho. Carregue-o no terminal antes de rodar o projeto:
#   set -a; source .env; set +a

# Sem esta variável, o desenvolvimento usa uma chave temporária, e as sessões caem ao
# reiniciar o servidor. Para gerar um valor:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
